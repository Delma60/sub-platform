generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  rider
}

enum PlanId {
  single
  family
  bulk
}

enum PlanFrequency {
  weekly
  biweekly
  monthly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  payment_failed
}

enum OrderStatus {
  processing
  packed
  out_for_delivery
  delivered
}

enum DeliveryStatus {
  scheduled
  out_for_delivery
  delivered
  issue
  skipped
}

enum PaymentStatus {
  success
  failed
  pending
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationStatus {
  sent
  failed
  skipped
}

enum NotificationType {
  order_confirmation
  receipt
  delivery_reminder
  payment_success
  payment_failed
  delivery_status
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String?
  passwordHash  String
  role          UserRole        @default(customer)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  addresses     Address[]
  subscriptions Subscription[]
  orders        Order[]
  deliveries    Delivery[] @relation("CustomerDeliveries")
  assignedDeliveries Delivery[] @relation("RiderDeliveries")
  payments      Payment[]
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  notificationPreference NotificationPreference?
}

model Address {
  id        String    @id
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries Delivery[]

  @@index([userId])
}

model Subscription {
  id               String             @id
  userId           String
  planId           PlanId
  status           SubscriptionStatus @default(active)
  nextDeliveryDate DateTime
  deliveryDayOfWeek Int?
  itemSwaps        Json               @db.JsonB @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orders           Order[]

  @@index([userId])
}

model Order {
  id             String      @id
  userId         String
  subscriptionId String
  planId         PlanId
  status         OrderStatus @default(processing)
  total          Int
  createdAt      DateTime    @default(now())
  deliveryDate   DateTime
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries     Delivery[]
  payments       Payment[]
  items          OrderItem[]

  @@index([userId])
  @@index([subscriptionId])
  @@unique([subscriptionId, deliveryDate])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  quantity  Int      @default(1)
  unitPrice Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id            String         @id
  userId        String
  orderId       String
  addressId     String?
  status        DeliveryStatus @default(scheduled)
  scheduledDate DateTime
  deliveredAt   DateTime?
  riderId       String?
  user          User           @relation("CustomerDeliveries", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rider         User?          @relation("RiderDeliveries", fields: [riderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  address       Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([riderId])
}

model Payment {
  id        String        @id
  userId    String
  orderId   String
  amount    Int
  status    PaymentStatus @default(pending)
  method    String
  externalReference String? @unique
  providerTransactionId String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([orderId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model NotificationPreference {
  userId            String   @id
  inAppEnabled      Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  orderUpdates      Boolean  @default(true)
  paymentUpdates    Boolean  @default(true)
  deliveryReminders Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus @default(sent)
  title     String
  body      String
  metadata  Json                @db.JsonB @default("{}")
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}

model Product {
  id          String   @id
  name        String
  slug        String   @unique
  category    String
  description String?
  price       Int
  unit        String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([category])
}

model Plan {
  id        PlanId        @id
  name      String
  price     Int
  frequency PlanFrequency
  features  String[]
  updatedAt DateTime      @updatedAt
}
